BASE_URL=https://example.com/auth/login/
LOGIN_EMAIL=example@email.com
LOGIN_PASSWORD=example-password
HEADLESS=false
BROWSER=chromium
TIMEOUT=30000

# Centralized Playwright timeouts, applied to every page/action/navigation
# project-wide (see conftest.py's `page` fixture). Change these here - never
# hardcode a timeout value in a test/page object.
DEFAULT_TIMEOUT_MS=15000
NAVIGATION_TIMEOUT_MS=30000
ASSERTION_TIMEOUT_MS=15000

# Minimum pass rate (%) for the report's "Deployment Successful" banner.
# SUCCESS_THRESHOLD is accepted as an alias if DEPLOYMENT_SUCCESS_THRESHOLD
# is not set.
DEPLOYMENT_SUCCESS_THRESHOLD=95

# Credentials with special characters (#, quotes, spaces): wrap the value in
# double quotes, e.g. LOGIN_PASSWORD="p@ss #1 word's \"quoted\" part" - a
# bare '#' with no quotes starts a comment and truncates the value.
